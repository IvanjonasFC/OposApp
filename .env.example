
# =============================================================
#  OposApp NAS — Plantilla de variables de entorno
#  Copia este fichero como ".env" y rellena los valores reales.
#  Este fichero SI se sube a Git (sin valores sensibles).
#  Referencia: README.md seccion "Despliegue en NAS"
# =============================================================

# ── Base de datos PostgreSQL ──────────────────────────────────
# Sustituye <IP_NAS> y <PUERTO> por los valores de tu entorno
DB_URL=jdbc:postgresql://<IP_NAS>:<PUERTO>/tfg_db?currentSchema=tfg
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_contrasena_postgres

# ── JWT HS512 ─────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=GENERAR_CON_openssl_rand_-base64_64

# ── Correo SMTP ───────────────────────────────────────────────
MAIL_USER=tu_email@gmail.com
MAIL_PASSWORD=tu_gmail_app_password_de_16_chars

# ── Ollama ────────────────────────────────────────────────────
# Sustituye <IP_OLLAMA> por la IP del servidor donde corre Ollama
OLLAMA_URL=http://<IP_OLLAMA>:11434
OLLAMA_MODEL_FREE=qwen2.5-coder:7b-instruct
OLLAMA_MODEL_PREMIUM=qwen2.5-coder:14b-instruct-q3_K_M

# ── URL publica ───────────────────────────────────────────────
APP_URL=https://tu-dominio.ejemplo.com

# ── Spring profile ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=nas
